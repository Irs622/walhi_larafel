# ─────────────────────────────────────────────────────────────
# WALHI Jawa Barat — MySQL 8.0 Tuning for 4 GB RAM VPS
# Target MySQL Resident Memory: ~700 MB – 1.0 GB
# ─────────────────────────────────────────────────────────────

[mysqld]
# ── InnoDB Memory & Buffer Management ──
innodb_buffer_pool_size = 512M
innodb_buffer_pool_instances = 1
innodb_redo_log_capacity = 128M

# ── Connection & Concurrency Control ──
# Concurrency matched to PHP-FPM max_children (8-12) + background/cli tasks
max_connections = 40
max_connect_errors = 1000

# ── Table & Thread Caches ──
table_open_cache = 400
table_definition_cache = 400
thread_cache_size = 8

# ── Per-Query Temporary Tables ──
max_heap_table_size = 32M
tmp_table_size = 32M

# ── Character Set ──
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Observability is kept ON by default for data-driven monitoring
# performance_schema = ON

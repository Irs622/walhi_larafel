# ─────────────────────────────────────────────────────────────
# WALHI Jawa Barat — MySQL 8.0 Tuning for 8 GB RAM / 2 vCPU VPS
# Target MySQL Resident Memory: ~1.8 GB – 2.2 GB
# ─────────────────────────────────────────────────────────────

[mysqld]
# ── InnoDB Memory & Buffer Management ──
# 1.5 GB dedicated buffer pool caches full dataset and indexes in RAM
innodb_buffer_pool_size = 1536M
innodb_buffer_pool_instances = 2
innodb_redo_log_capacity = 256M

# ── Connection & Concurrency Control ──
# Concurrency matched to PHP-FPM max_children (18) + artisan/cli tasks
max_connections = 80
max_connect_errors = 1000

# ── Table & Thread Caches ──
table_open_cache = 800
table_definition_cache = 600
thread_cache_size = 16

# ── Per-Query Temporary Tables ──
max_heap_table_size = 64M
tmp_table_size = 64M

# ── Character Set ──
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Observability is kept ON by default for data-driven monitoring
# performance_schema = ON

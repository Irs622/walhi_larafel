<IfModule mod_rewrite.c>
    RewriteEngine On
    # Forward all traffic to the public/ folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to sensitive files and directories
<FilesMatch "^\.env|composer\.(json|lock)|\.(sql|sql\.gz|sqlite|sqlite-wal|sqlite-shm|zip|log|key|pem|crt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to hidden files and directories (e.g. .git, .env, .vscode)
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} "!(^|/)\.well-known([^./]+)?/" [NC]
    RewriteRule "(^|/)\." - [F]
</IfModule>

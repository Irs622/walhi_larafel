# ═════════════════════════════════════════════════════════════
# WALHI Jawa Barat — Production Environment Configuration
# Salin file ini menjadi .env pada server live / VPS produksi.
# ═════════════════════════════════════════════════════════════

APP_NAME="WALHI Jawa Barat"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://walhijabar.or.id
APP_KEY=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── LOGGING ──
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_MAX_FILES=30

# ── DATABASE (MySQL Production) ──
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=walhi_prod
DB_USERNAME=walhi_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_KUAT
DB_ROOT_PASSWORD=GANTI_DENGAN_ROOT_PASSWORD_KUAT

# ── SESSION & KEAMANAN COOKIE ──
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# ── QUEUE & CACHE ──
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ── EMAIL (SMTP Pengiriman Notifikasi) ──
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=kontak@walhijabar.or.id
MAIL_PASSWORD=GANTI_DENGAN_APP_PASSWORD_EMAIL
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="kontak@walhijabar.or.id"
MAIL_FROM_NAME="WALHI Jawa Barat"

# ── MIDTRANS PAYMENT GATEWAY (PRODUKSI) ──
MIDTRANS_SERVER_KEY=Mid-server-GANTI_DENGAN_SERVER_KEY_PRODUKSI
MIDTRANS_CLIENT_KEY=Mid-client-GANTI_DENGAN_CLIENT_KEY_PRODUKSI
MIDTRANS_IS_PRODUCTION=true

# ── ADMIN DEFAULT SEED (Hanya untuk inisialisasi awal) ──
ADMIN_EMAIL=admin@walhijabar.or.id
ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN_KUAT
SEED_ON_START=false
